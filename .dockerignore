# Excluded from the Docker build context.
# - Secrets: `COPY . .` would bake a stray .env into the builder/migrator layers.
# - Cache: node_modules (~700 MB) would bust the build cache and slow every build.

# --- Dependencies: reinstalled inside the image from the lockfile ---
node_modules
**/node_modules
.pnpm-store
.yarn
.npm

# --- Secrets. Never in a layer. ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
**/*.secret

# --- VCS and CI ---
.git
.gitignore
.gitattributes
.github

# --- Build output: regenerated inside the image ---
.next
out
build
dist
*.tsbuildinfo
next-env.d.ts

# --- Test artefacts ---
coverage
playwright-report
test-results
blob-report
.playwright
tests/**/__screenshots__

# --- Infra and docs: not needed to build the app; editing them must not bust the cache ---
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.prod.yml
infra
docs
backups
*.dump
*.sql.gz

# --- Editor / OS noise ---
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.log
npm-debug.log*
pnpm-debug.log*
