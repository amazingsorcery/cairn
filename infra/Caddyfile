# Caddy v2 — TLS termination, security headers, reverse proxy to the app container.
#
# {$DOMAIN} and {$ACME_EMAIL} come from the container environment (.env). To change domain:
#     edit .env  ->  docker compose -f docker-compose.prod.yml up -d caddy
#
# Validate after any change, before restarting:
#     docker compose -f docker-compose.prod.yml exec caddy caddy validate --config /etc/caddy/Caddyfile
# Reload without dropping connections or re-requesting certificates:
#     docker compose -f docker-compose.prod.yml exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	# Let's Encrypt expiry-warning contact.
	email {$ACME_EMAIL}

	# Use the staging directory while testing DNS/firewall changes (production allows 5
	# failed authorisations per hostname per hour):
	#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA}

	servers {
		# Caddy is the edge, so no trusted_proxies: the client IP is the TCP peer. If a CDN
		# is added, set `trusted_proxies static <cidr>` and make header_up append again.
	}
}

# Generated by `pnpm csp:generate`.
import csp.caddy

{$DOMAIN} {
	# --- Compression ------------------------------------------------------------------
	# Caddy's default matcher with `text/*` expanded so `text/event-stream` is excluded
	# (compressing a stream buffers it). Adding types is fine; don't add `text/*` back.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/xml*
			header Content-Type text/markdown*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
		}
	}

	# --- Request body limit -----------------------------------------------------------
	# 413 above this. There are no uploads, so this could likely drop to 1MB.
	request_body {
		max_size 10MB
	}

	# --- Security headers -------------------------------------------------------------
	header {
		# HSTS, 2 years, preload-eligible. Preloading (manual submission at hstspreload.org)
		# is hard to undo and covers every subdomain; only submit once that's certain.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		X-Content-Type-Options "nosniff"

		# Outbound tool links must not tell vendors the visitor came from here. If
		# same-origin referrers are ever needed, use `same-origin`.
		Referrer-Policy "no-referrer"

		# Legacy counterpart to CSP frame-ancestors.
		X-Frame-Options "DENY"

		# Deny unused capabilities, including Chrome's Topics API.
		Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

		# COOP cuts window.opener from linked pages; CORP blocks cross-origin embedding.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# The legacy XSS auditor is itself exploitable; `0` disables it.
		X-XSS-Protection "0"

		-Server
		-X-Powered-By

		# ==============================================================================
		# Content Security Policy notes
		# ==============================================================================
		# The CSP is set with `?` (only if the app didn't set one), so a future
		# nonce-based CSP from middleware would take over automatically.
		#
		# Loosened directives:
		# 1) script-src 'unsafe-inline': Next.js streams the RSC payload as inline scripts
		#    that differ per request. Tightening needs per-request nonces via middleware
		#    (`'nonce-..' 'strict-dynamic'`), which makes every route dynamic.
		# 2) style-src 'unsafe-inline': Radix and React `style` props write inline style
		#    attributes, which nonces can't cover. Could likely split into
		#    `style-src-elem 'self'; style-src-attr 'unsafe-inline'` after testing the build.
		# 3) img-src data: blob:: inline icons and client-side export object URLs. Don't
		#    hotlink third-party favicons/logos; each origin learns what was viewed.
		# 4) form-action https://github.com: Chrome checks form-action against the whole
		#    redirect chain of the GitHub sign-in POST.
		#
		# Not set: report-uri/report-to (no endpoint; reports contain visited URLs) and
		# require-trusted-types-for (breaks React/Radix).
		#
		# The policy itself is generated into csp.caddy because img-src depends on which
		# camera providers may be embedded.
		# ==============================================================================
	}

	# --- Content-Security-Policy ----------------------------------------------------
	# Run `pnpm csp:generate` after changing content/cameras/ or config/live.ts; CI's
	# `pnpm csp:check` fails on drift.
	import cairn_csp

	# --- Access log -------------------------------------------------------------------
	# Skip uptime-monitor noise.
	@health path /api/health
	log_skip @health

	log {
		# stdout so Docker's rotated json-file driver is the only log on disk.
		output stdout

		format filter {
			wrap json

			fields {
				# Already redacted by default; explicit in case the default changes.
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete

				# Mask client IPs (/24, /48): enough for network-level abuse diagnosis,
				# not enough to identify an individual reader.
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	# --- Reverse proxy ----------------------------------------------------------------
	# `web:3000` on the `edge` network; the port isn't published, so this is the only path.
	# The map polls `/map/data/<layer>` with ordinary requests; there is no streaming route.

	handle {
		reverse_proxy web:3000 {
			# Overwrite, not append, so clients can't spoof their address.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}

			# Auth.js builds callback URLs from these (with AUTH_TRUST_HOST=true); otherwise
			# it would see the plain-HTTP hop and generate http:// URLs.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			# Default behaviour, stated explicitly.
			header_up Host {host}

			# dial_timeout covers a down app (fast 502). response_header_timeout covers a
			# slow one; Server Actions and route handlers send no headers until done, so it
			# bounds the whole request. 60s = the largest connector timeout_ms (40s, crt.sh
			# and Wayback) + 20s for audit/rate-limit writes and rendering.
			# infra/caddy-timeout.contract.test.ts checks this against the seeded connectors.
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# --- Error pages ------------------------------------------------------------------
	# Plain-text status instead of an empty body when the app is down.
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# No `www.` redirect: Caddy would request a certificate for it, and a missing DNS record
# burns the Let's Encrypt rate limit. Create the www record first, then add a site block
# for `www.{$DOMAIN}` that redirects to `https://{$DOMAIN}{uri}`.
