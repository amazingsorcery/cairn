[Unit]
Description=Nightly PostgreSQL dump, verification, rotation and offsite copy
# Useless without the Docker daemon, hence Requires.
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot

# Edit to match your checkout and user (must be in `docker` and own BACKUP_DIR).
User=deploy
WorkingDirectory=/opt/app
ExecStart=/opt/app/infra/backup.sh

# A run normally takes minutes; kill a hung pg_dump or stalled upload.
TimeoutStartSec=30min

# One retry for transient network failures during the offsite copy.
Restart=on-failure
RestartSec=5min

#   journalctl -u app-backup.service --since yesterday
StandardOutput=journal
StandardError=journal

# ProtectSystem=strict tends to break docker socket access.
NoNewPrivileges=true

# Must stay false: backup.sh and deploy.sh share a flock in /tmp.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
