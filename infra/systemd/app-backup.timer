[Unit]
Description=Run the nightly database backup

[Timer]
# 03:12 server time (UTC). Off the hour to avoid the usual scheduling pile-up.
OnCalendar=*-*-* 03:12:00

RandomizedDelaySec=5min

# Run a missed backup as soon as the machine is back up.
Persistent=true

# Give Docker time to start the stack after boot.
OnBootSec=10min

[Install]
WantedBy=timers.target
