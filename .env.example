# =======================================================================================
# Environment template. Copy to `.env` and fill in. Never commit `.env`.
#
#     cp .env.example .env
#     chmod 600 .env
#
# Values still reading CHANGEME, REPLACE_ME or example.invalid have not been set.
#
# Read by docker compose (variable substitution), by `env_file:` on the web and migrate
# services, and by Next.js in local dev, so it must be `.env` at the repo root.
#
# Nothing here is prefixed NEXT_PUBLIC_; that would inline the value into the client bundle.
# =======================================================================================


# ---------------------------------------------------------------------------------------
# Runtime basics
# ---------------------------------------------------------------------------------------

# Required. Values: development | test | production
# The Dockerfile sets production in the container.
NODE_ENV=development

# Container timezone (psql timestamps, backup filenames). Optional. Default: UTC.
# Keep UTC on the server to avoid DST-duplicated hours and colliding backup names.
TZ=UTC

# pino log level. Optional. Default: info.
# Values: trace | debug | info | warn | error | fatal | silent  (enforced by lib/env.schema.ts)
# Avoid debug in production: it can log request bodies, i.e. user case notes.
LOG_LEVEL=info


# ---------------------------------------------------------------------------------------
# Public identity: URL and domain
# ---------------------------------------------------------------------------------------

# Domain Caddy serves and gets a certificate for. No scheme, trailing slash or port.
# Required in production. Must resolve to this server before the first deploy or ACME fails.
# Unused locally.
DOMAIN=example.invalid

# Let's Encrypt expiry-warning contact. Required in production; use a monitored mailbox.
ACME_EMAIL=ops@example.invalid

# ACME directory. Optional. Default: Let's Encrypt production.
# Use staging while testing DNS/firewall changes (production allows 5 failed authz/host/hour).
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Public base URL with scheme, no trailing slash. Required. Used for canonical URLs and
# magic-link emails; must match what the browser sees.
# Production: https://your.domain          Local: http://localhost:3000
APP_URL=http://localhost:3000

# Auth.js base URL; keep equal to APP_URL. Auth.js reads it from process.env directly, so it
# is not in lib/env.schema.ts. A mismatch redirects sign-in to the wrong origin.
AUTH_URL=http://localhost:3000

# Lets Auth.js derive the origin from X-Forwarded-Host/Proto. Must be `true` in production
# because the app only sees plain HTTP from Caddy. Safe only because Caddy overwrites those
# headers (see infra/Caddyfile). Harmless locally.
AUTH_TRUST_HOST=true


# ---------------------------------------------------------------------------------------
# Secrets — generate these, never invent them by hand
# ---------------------------------------------------------------------------------------

# Signs/encrypts session cookies and magic-link tokens. Required.
# Changing it invalidates all sessions and outstanding magic links.
#   openssl rand -base64 32
# Portable alternative if openssl is unavailable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGEME_run_openssl_rand_base64_32


# HMAC key for rate-limit subjects (emails, IPs), so counters don't store who did what.
# Required, at least 32 characters, and must differ from AUTH_SECRET (the schema checks).
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it just resets current rate-limit windows.
RATE_LIMIT_SECRET=CHANGEME_run_openssl_rand_hex_32


# Postgres pool size for the web container. Optional. Default 10.
# docker-compose.prod.yml sets max_connections=60; raise both together.
# DATABASE_POOL_MAX=10


# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
# POSTGRES_* are used by the postgres image on first boot only; DATABASE_URL is used by the
# app and migrations. They must agree.

# Required.
POSTGRES_USER=app

# Required. Use hex: base64 can contain + and / which need percent-encoding in DATABASE_URL.
#   openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME_run_openssl_rand_hex_32

# Required.
POSTGRES_DB=app

# First boot only: changing POSTGRES_PASSWORD later does not affect an existing cluster.
# To rotate, change it in the database too, then update .env and restart web:
#   docker compose -f docker-compose.prod.yml exec db \
#     psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER ROLE \"$POSTGRES_USER\" WITH PASSWORD 'new-password';"

# Connection string for the app and `pnpm db:migrate`. Required.
#   In containers: host is `db`.
#   On the host (pnpm dev, drizzle-kit studio, psql): host is `localhost`.
# Production value:
#   DATABASE_URL=postgres://app:<POSTGRES_PASSWORD>@db:5432/app
# Local development value (matches docker-compose.yml defaults):
DATABASE_URL=postgres://app:devpassword@localhost:5432/app


# =======================================================================================
# Sign-in: pick one of three states
# =======================================================================================
#
# Accounts are only needed for case workspaces; everything else is public. The app logs
# its sign-in state at startup.
#
#   State 1 — public only: leave this section unset. /signin and /workspaces return 404
#     and "save to a case" buttons are hidden.
#
#   State 2 — GitHub sign-in: set both AUTH_GITHUB_* values. Easiest option; one OAuth app
#     form on github.com.
#
#   State 3 — email link: set all five SMTP_* values from a mail-sending provider. Needs
#     SPF, DKIM and DMARC on your domain or the links land in spam.
#
# States 2 and 3 can be combined. A partial provider config (e.g. four of five SMTP values,
# or an ID without a secret) makes the app refuse to start.


# ---------------------------------------------------------------------------------------
# STATE 2: GitHub OAuth  (both values, or neither)
# ---------------------------------------------------------------------------------------
# Create at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage URL:               the value of APP_URL
#   Authorization callback URL: <APP_URL>/api/auth/callback/github
# The callback must match exactly. Use a separate OAuth app for local development.
# Uncomment both lines and restart to enable.

# AUTH_GITHUB_ID=CHANGEME_github_oauth_client_id

# Shown once by GitHub; regenerate it if lost.
# AUTH_GITHUB_SECRET=CHANGEME_github_oauth_client_secret


# ---------------------------------------------------------------------------------------
# STATE 3: email magic link over SMTP  (all five values, or none)
# ---------------------------------------------------------------------------------------
# Sent via nodemailer; any SMTP provider works. The sending domain needs SPF, DKIM and DMARC.
#
# Locally, mailpit in docker-compose.yml catches mail (UI at http://localhost:8025):
#   SMTP_HOST=localhost   SMTP_PORT=1025   SMTP_USER=dev   SMTP_PASSWORD=dev
#   SMTP_FROM=no-reply@example.invalid

# SMTP_HOST=smtp.your-provider.example

#   587  STARTTLS (preferred)
#   465  implicit TLS
#   25   usually blocked outbound on VPS providers
#   1025 local mailpit
# SMTP_PORT=587

# Usually the sending address or a provider API-key id.
# SMTP_USER=CHANGEME_smtp_username

# Password or API key from the provider.
# SMTP_PASSWORD=CHANGEME_smtp_password

# Bare address only (validated with .email()); `Name <addr>` fails boot. The display name
# comes from config/brand.ts. Domain must authorise the provider via SPF/DKIM.
# SMTP_FROM=no-reply@example.invalid


# ---------------------------------------------------------------------------------------
# Authorisation
# ---------------------------------------------------------------------------------------

# Comma-separated emails granted admin on first sign-in. Optional. Default: none.
# The role is set when the account is created, so add yourself before signing in;
# otherwise update the row by hand.
#   ADMIN_EMAILS=you@your.domain,colleague@your.domain
ADMIN_EMAILS=


# ---------------------------------------------------------------------------------------
# Deployment and image naming
# ---------------------------------------------------------------------------------------

# Prefix for container, network and volume names. Optional. Default: `app`.
# Changing it after the first deploy orphans the existing volumes.
COMPOSE_PROJECT_NAME=app

# Web image name. Optional. Default: `app-web`. Brand-neutral by design.
# infra/deploy.sh retags :current to :previous before each build for rollback.
IMAGE_NAME=app-web

# Optional. Default: `current`. deploy.sh assumes `current`/`previous` tags.
IMAGE_TAG=current


# ---------------------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------------------

# Directory on the HOST where pg_dump archives are written.
# Optional. Default: /var/backups/app-db
# Needs room for ~11 dumps (7 daily + 4 weekly).
BACKUP_DIR=/var/backups/app-db

# How many daily dumps to keep. Optional. Default: 7.
BACKUP_KEEP_DAILY=7

# How many weekly dumps to keep. Optional. Default: 4.
# A weekly is promoted from the Sunday daily, so 7 daily + 4 weekly gives a ~35-day window.
BACKUP_KEEP_WEEKLY=4

# rclone remote for offsite copies, `remote:path`. Optional; offsite copying is off if empty.
# Configure with `rclone config` first (credentials stay in rclone.conf), e.g.:
#   BACKUP_RCLONE_REMOTE=backups-b2:my-bucket/db
BACKUP_RCLONE_REMOTE=


# =======================================================================================
# Live sources
# =======================================================================================
# All optional. A missing key disables that one map layer ("source unavailable"); it never
# stops the process.

# NASA FIRMS wildfire hotspots.
# Register (free, instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# The adapter's response schema has not been verified against a real payload.
FIRMS_MAP_KEY=

# Which FIRMS product to read. Default VIIRS_SNPP_NRT.
FIRMS_SOURCE=

# USGS earthquake feed window: all_hour, all_day, all_week. Default all_day.
# No key needed — USGS is US Government public domain.
USGS_QUAKE_FEED=

# Default aircraft viewport, "lat,lon,radiusNm".
# Cache TTL is 30s: adsb.lol refuses at ~10 req/min, which allows about three concurrent
# viewports.
AIRCRAFT_VIEWPORT=

# Contact address sent in the User-Agent where upstreams ask for one (NWS, Nominatim).
SOURCE_CONTACT_EMAIL=

# =======================================================================================
# No Redis or worker
# =======================================================================================
#
# There is no REDIS_* or WORKER_* config. The source cache is in-process
# (`app/(public)/map/sources.ts`) and rate limiting is a fixed-window table in Postgres.
# Upstream call rate therefore scales with distinct concurrent viewports; this only matters
# for the aircraft layer (see AIRCRAFT_VIEWPORT).

# Socrata app token for the Seattle and San Francisco 911 feeds. Optional and free; it only
# raises the anonymous rate limit.
# Register: https://dev.socrata.com/docs/app-tokens.html
SOCRATA_APP_TOKEN=
