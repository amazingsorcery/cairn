# =======================================================================================
# Environment template. Copy to `.env` and fill in. NEVER commit `.env`.
#
#     cp .env.example .env
#     chmod 600 .env
#
# Every placeholder below is obviously fake on purpose. If a value in your `.env` still
# says CHANGEME, REPLACE_ME, or example.invalid, it has not been set.
#
# This one file is read by three different consumers, which is why it must live at the
# repository root and be named exactly `.env`:
#   1. The docker compose CLI, for `${...}` substitution inside the compose files
#      (this is what makes ${DOMAIN} and ${POSTGRES_PASSWORD} work there).
#   2. `env_file:` on the web and migrate services, which injects it into the containers.
#   3. Next.js in local development, which loads `.env` automatically.
#
# NAMING NOTE: nothing here is prefixed NEXT_PUBLIC_. That prefix inlines a value into the
# JavaScript bundle sent to every visitor. No variable in this file may ever gain it.
# =======================================================================================


# ---------------------------------------------------------------------------------------
# Runtime basics
# ---------------------------------------------------------------------------------------

# What mode the app runs in. Affects React's build, error verbosity and cookie security.
# Required. Default: development locally, production in the container (the Dockerfile sets
# it; you do not need to set it here for a deploy).
# Values: development | test | production
NODE_ENV=development

# Timezone for the containers, and therefore for Postgres timestamps rendered by psql and
# for the backup filenames. Optional. Default: UTC.
# Keep this UTC on the server. Local time in logs across a DST boundary produces an hour
# that happens twice, and backup filenames that collide.
TZ=UTC

# Application log verbosity, consumed by pino.
# Optional. Default: info.
# Values: trace | debug | info | warn | error | fatal | silent  (enforced by lib/env.schema.ts)
# Use info in production. debug logs request bodies in most pino setups, which on this
# product means user case notes in the container log — do not leave it on.
LOG_LEVEL=info


# ---------------------------------------------------------------------------------------
# Public identity: URL and domain
# ---------------------------------------------------------------------------------------

# The domain Caddy serves and requests a certificate for. Apex or subdomain, no scheme,
# no trailing slash, no port.
# REQUIRED in production. Compose refuses to start without it.
# It must already resolve to this server's public IP before the first deploy, or ACME
# fails — see RUNBOOK "DNS".
# Local development: leave the example value; Caddy is not used locally.
DOMAIN=example.invalid

# Contact address Let's Encrypt uses for certificate-expiry warnings.
# REQUIRED in production. Use a mailbox a human actually reads; it is the only warning you
# get if renewal silently starts failing.
ACME_EMAIL=ops@example.invalid

# ACME directory endpoint.
# Optional. Default: the Let's Encrypt production directory.
# Set to the staging URL below while testing DNS or firewall changes. Production allows
# only 5 failed authorisations per hostname per hour.
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Absolute public base URL of the app, including scheme. No trailing slash.
# REQUIRED. Used for absolute links, canonical URLs, and the links inside magic-link
# emails. Must match what the browser actually sees or sign-in breaks.
# Production: https://your.domain          Local: http://localhost:3000
APP_URL=http://localhost:3000

# Base URL Auth.js uses to construct OAuth callback and magic-link URLs.
# Recommended in production; always identical to APP_URL in this deployment.
# It is a separate variable because Auth.js reads AUTH_URL from process.env by NAME, on
# its own — it is deliberately not part of lib/env.schema.ts, which validates what the
# application reads. Set both and keep them equal; a mismatch produces sign-in redirects
# to the wrong origin, which is a confusing failure to diagnose.
AUTH_URL=http://localhost:3000

# Tells Auth.js to derive the request origin from the X-Forwarded-Host / X-Forwarded-Proto
# headers instead of insisting on a hardcoded URL.
# REQUIRED and must be `true` in production, because the app sits behind Caddy and only
# ever sees a plain-HTTP request on web:3000. Without it, Auth.js generates http:// or
# localhost callback URLs and every sign-in fails.
# This is only safe because Caddy overwrites those headers rather than passing through
# whatever the client sent (see infra/Caddyfile, reverse_proxy block).
# Local development: not needed, but harmless.
AUTH_TRUST_HOST=true


# ---------------------------------------------------------------------------------------
# Secrets — generate these, never invent them by hand
# ---------------------------------------------------------------------------------------

# Signs and encrypts session cookies and the magic-link tokens.
# REQUIRED. No default. If this changes, every existing session and every unclicked
# magic link is invalidated immediately.
# Generate exactly this way (32 random bytes, base64):
#   openssl rand -base64 32
# Portable alternative if openssl is unavailable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGEME_run_openssl_rand_base64_32


# Keys the rate-limit table. Subjects (email addresses, IP addresses) are HMAC-hashed with
# this before they are ever written, so the counters cannot be read back as a record of who
# did what — see ADR 0009.
# REQUIRED. No default. At least 32 characters. The application REFUSES TO BOOT without it.
# It must NOT be the same value as AUTH_SECRET; the schema rejects that, because reusing one
# secret across two purposes means rotating either one silently breaks the other.
# Generate exactly this way (32 random bytes, hex):
#   openssl rand -hex 32
# Portable alternative if openssl is unavailable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it resets every in-flight rate-limit window. That is harmless.
RATE_LIMIT_SECRET=CHANGEME_run_openssl_rand_hex_32


# Maximum size of the Postgres connection pool held by ONE container.
# OPTIONAL. Default 10.
#
# v2 note: TWO containers now read this — `web` and `worker` — so the real load on Postgres
# is twice this number plus whatever a migration or a pg_dump is holding.
# docker-compose.prod.yml sets `max_connections=60` with that in mind. Raise this only if
# you raise max_connections as well; a pool larger than the server allows fails at peak
# load, which is exactly when you will not want to be debugging it.
# DATABASE_POOL_MAX=10


# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
# The POSTGRES_* trio and DATABASE_URL describe the same database twice, for two different
# consumers, and they MUST agree:
#   * POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB are read by the postgres image to
#     create the cluster on first boot. They are ignored on every subsequent boot — see
#     the warning below.
#   * DATABASE_URL is read by the application and by the Drizzle migration script.

# Database role name. REQUIRED. Default: none.
POSTGRES_USER=app

# Database role password. REQUIRED. No default.
# Generate a URL-safe value — `openssl rand -base64` can emit `+` and `/`, which must be
# percent-encoded inside DATABASE_URL and are a classic source of "password authentication
# failed" with a password that looks correct. Use hex and avoid the problem entirely:
#   openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME_run_openssl_rand_hex_32

# Database name. REQUIRED. Default: none.
POSTGRES_DB=app

# !! FIRST-BOOT ONLY !!
# The postgres image runs initdb only when its data volume is empty. Changing
# POSTGRES_PASSWORD later has NO effect on an existing cluster — the container starts
# fine and the app then fails to authenticate, which looks like a bug in the app. To
# rotate it for real you must also change it inside the running database:
#   docker compose -f docker-compose.prod.yml exec db \
#     psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER ROLE \"$POSTGRES_USER\" WITH PASSWORD 'new-password';"
# then update .env and restart web. RUNBOOK has the full procedure.

# Full connection string used by the app and by `pnpm db:migrate`.
# REQUIRED. No default.
#   In containers (production, and the prodtest profile): host is `db`, the compose
#     service name, on the internal network.
#   On the host (local `pnpm dev`, drizzle-kit studio, psql): host is `localhost` and the
#     port is the one docker-compose.yml publishes.
# Production value:
#   DATABASE_URL=postgres://app:<POSTGRES_PASSWORD>@db:5432/app
# Local development value (matches docker-compose.yml defaults):
DATABASE_URL=postgres://app:devpassword@localhost:5432/app


# ---------------------------------------------------------------------------------------
# Authentication provider: GitHub OAuth
# ---------------------------------------------------------------------------------------
# Create at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage URL:               the value of APP_URL
#   Authorization callback URL: <APP_URL>/api/auth/callback/github
# The callback must match byte for byte, including scheme and any trailing path. Register
# a SEPARATE OAuth app for local development with the localhost callback — do not add
# localhost as a second callback on the production app.

# The OAuth app's Client ID. REQUIRED for GitHub sign-in. Not secret, but not useful
# alone. No default.
AUTH_GITHUB_ID=CHANGEME_github_oauth_client_id

# The OAuth app's Client Secret. REQUIRED for GitHub sign-in. No default.
# Generated by GitHub, shown once at creation. If you lose it, generate a new one in the
# OAuth app settings; you cannot recover the old one.
AUTH_GITHUB_SECRET=CHANGEME_github_oauth_client_secret


# ---------------------------------------------------------------------------------------
# Authentication provider: email magic link (SMTP)
# ---------------------------------------------------------------------------------------
# Sent via nodemailer. Any SMTP provider works; no provider-specific SDK is used.
# Deliverability, not code, is the hard part — SPF, DKIM and DMARC records must exist for
# the sending domain or the mail lands in spam and users report "the link never arrived".
# RUNBOOK has the DNS records and the triage steps.

# SMTP server hostname. REQUIRED for magic-link sign-in. No default.
# Local development: `localhost` (the mailpit container in docker-compose.yml).
SMTP_HOST=localhost

# SMTP port. REQUIRED. Default: none — set it explicitly.
#   587  submission with STARTTLS. Prefer this.
#   465  implicit TLS. Also fine.
#   25   do not use; most VPS providers block outbound 25 by default.
#   1025 the local mailpit container.
SMTP_PORT=1025

# SMTP username. REQUIRED in production; usually the full sending address or an API-key
# identifier from the provider. No default.
# Local development with mailpit: any value, it accepts anything.
SMTP_USER=CHANGEME_smtp_username

# SMTP password or API key. REQUIRED in production. No default.
# This is issued by your mail provider — you do not generate it locally. Treat it as a
# credential that can send mail as your domain, because it is one.
# Local development with mailpit: any value.
SMTP_PASSWORD=CHANGEME_smtp_password

# The From: address on magic-link emails. REQUIRED. No default.
# Must be on a domain whose SPF/DKIM records authorise your SMTP provider, or delivery
# will fail silently into spam.
#
# A BARE ADDRESS ONLY. lib/env.schema.ts validates this with .email(), so the
# display-name form `Name <no-reply@your.domain>` is REJECTED and the app will refuse to
# boot. That is the right call anyway: the display name is a brand string and belongs in
# config/brand.ts, where renaming the product stays a one-file change.
SMTP_FROM=no-reply@example.invalid


# ---------------------------------------------------------------------------------------
# Authorisation
# ---------------------------------------------------------------------------------------

# Comma-separated email addresses granted the admin role on first sign-in.
# Optional. Default: empty (nobody is an admin).
# Set this to your own address BEFORE the first sign-in — the role is assigned as the
# account is created, so adding yourself afterwards means the existing row already has the
# ordinary role and has to be updated in the database by hand.
#   ADMIN_EMAILS=you@your.domain,colleague@your.domain
ADMIN_EMAILS=


# ---------------------------------------------------------------------------------------
# Deployment and image naming
# ---------------------------------------------------------------------------------------

# Prefix for container, network and volume names. Optional. Default: `app`.
# Change it only before the first deploy — changing it later orphans the existing volumes,
# which is indistinguishable from data loss until you find them again with
# `docker volume ls`.
COMPOSE_PROJECT_NAME=app

# Local docker image name for the built web image. Optional. Default: `app-web`.
# Deliberately brand-neutral: the product name lives in config/brand.ts and renaming the
# product must not require touching infrastructure. infra/deploy.sh retags
# ${IMAGE_NAME}:current to ${IMAGE_NAME}:previous before every build so it has something
# to roll back to.
IMAGE_NAME=app-web

# Tag for the running image. Optional. Default: `current`.
# Leave this alone unless you are running two stacks side by side. deploy.sh assumes
# `current` and `previous` are the live and rollback tags.
IMAGE_TAG=current


# ---------------------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------------------

# Directory on the HOST where pg_dump archives are written.
# Optional. Default: /var/backups/app-db
# Must be on a filesystem with room for ~11 dumps (7 daily + 4 weekly). Check with
# `df -h` before the first run.
BACKUP_DIR=/var/backups/app-db

# How many daily dumps to keep. Optional. Default: 7.
BACKUP_KEEP_DAILY=7

# How many weekly dumps to keep. Optional. Default: 4.
# A weekly is promoted from the Sunday daily, so 7 daily + 4 weekly gives a ~35-day window.
BACKUP_KEEP_WEEKLY=4

# rclone remote to copy dumps to, in `remote:path` form.
# OPTIONAL, and empty by default — offsite copying is OFF until you set this.
# A backup that lives only on the machine it backs up does not survive the failure it
# exists for: provider account suspension, a deleted VPS, or ransomware all take both.
# Configure the remote first with `rclone config` (which stores its own credentials in
# ~/.config/rclone/rclone.conf — no credential belongs in this file), then set e.g.:
#   BACKUP_RCLONE_REMOTE=backups-b2:my-bucket/db
# See RUNBOOK "Offsite copies" for the scp alternative.
BACKUP_RCLONE_REMOTE=


# =======================================================================================
# Live sources (v2)
# =======================================================================================
# ALL OPTIONAL. A missing key disables ONE map layer with a visible "source unavailable"
# state; it never stops the process. That is deliberate — product-brief §2b says one bad
# upstream must never break the map, and a required key would make it do exactly that.

# NASA FIRMS wildfire hotspots.
# Register (free, instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NOTE: the FIRMS adapter's response schema is UNVERIFIED — a key is needed to capture a
# real payload and the build could not register an account. See docs/sources/nasa-firms.md.
FIRMS_MAP_KEY=

# Which FIRMS product to read. Default VIIRS_SNPP_NRT.
FIRMS_SOURCE=

# USGS earthquake feed window: all_hour, all_day, all_week. Default all_day.
# No key needed — USGS is US Government public domain.
USGS_QUAKE_FEED=

# Default aircraft viewport, "lat,lon,radiusNm".
# The TTL is 30s, not the 5-10s the brief targets. adsb.lol publishes no limit and refuses
# around 10 req/min; 30s leaves room for about three concurrent viewports before the global
# ceiling breaks. Read docs/decisions/0021 before raising it.
AIRCRAFT_VIEWPORT=

# Contact address sent in the User-Agent to upstreams that request one (NWS, Nominatim).
# Sending it is a condition of polite use. An operator who cannot be contacted is one who
# gets blocked without warning.
SOURCE_CONTACT_EMAIL=

# Redis: source cache, rate limiting, and pub/sub for live layer updates (ADR 0019).
# In Compose this is redis://redis:6379.
#
# HOST vs CONTAINER, and the failure it causes. `redis://localhost:6379` is correct when you
# run `pnpm dev` on your laptop against docker-compose.yml, and it is WRONG inside any
# container, where `localhost` is that container and nothing is listening on it. The symptom
# is not an error: lib/sources/cache.ts treats an unreachable cache as a cache miss, so the
# map keeps working, gets slower, and calls upstreams on every request instead of once per
# TTL — which is the thing ADR 0021's rate-limit arithmetic assumes cannot happen.
# docker-compose.yml overrides this for the `prodtest` profile for exactly that reason;
# docker-compose.prod.yml does not, so a production .env must say `redis://redis:6379`.
REDIS_URL=redis://redis:6379


# =======================================================================================
# Redis and worker operations (v2)
# =======================================================================================

# Password for Redis. OPTIONAL, and EMPTY BY DEFAULT — Redis runs with no authentication.
#
# WHY THAT IS THE DEFAULT, so the choice is visible rather than assumed. In this deployment
# Redis has no published port and sits only on the `backend` compose network, which is
# `internal: true` and therefore has no gateway: it is reachable from four containers on one
# host and from nothing else, not even the host's own network stack. Postgres has a password
# because the postgres image will not start without one, not because it is more exposed.
#
# WHEN TO SET IT: if anything else is ever co-tenanted on this box, if the backend network
# stops being `internal`, or if your threat model includes another process on the same host.
# Adding a password is cheap; adding it wrongly takes the site down, so all four steps:
#   1. Generate:  openssl rand -hex 32
#   2. Set REDIS_PASSWORD below.
#   3. Add `--requirepass ${REDIS_PASSWORD}` to the redis `command:` in
#      docker-compose.prod.yml, AND change its healthcheck to
#      `redis-cli -a "$${REDIS_PASSWORD}" ping`. Miss the healthcheck and Redis reports
#      NOAUTH, never goes healthy, and `web` and `worker` never start — the whole site is
#      down for a change that was meant to harden it.
#   4. Put the password in REDIS_URL too: redis://:<password>@redis:6379
# RUNBOOK section 20 has this as a checklist.
REDIS_PASSWORD=

# Redis memory ceiling, passed to `--maxmemory`. Optional. Default: 512mb.
# Accepts Redis's own units (512mb, 1gb). Keep it well under the redis container's
# `mem_limit` in docker-compose.prod.yml (768m): client output buffers and allocator
# fragmentation live OUTSIDE maxmemory, and a maxmemory equal to the container limit is how
# a cache gets OOM-killed by the kernel instead of evicting politely.
# The eviction policy is `allkeys-lru` and is NOT configurable here — see the block comment
# on the redis service, and HANDOFF section 15 for what it means for rate limiting.
REDIS_MAXMEMORY=512mb

# Port the worker binds its health and status listener to, inside its own container.
# Optional. Default: 9091. Published nowhere; Caddy has no route to it and the worker is not
# on the `edge` network. Three things read it: the Dockerfile HEALTHCHECK, the worker
# service's healthcheck, and infra/healthcheck.sh. Changing it means changing all three.
WORKER_HEALTH_PORT=9091
